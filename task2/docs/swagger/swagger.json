{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/repos/{owner}/{repo}": {
            "get": {
                "description": "Retrieves detailed information about a GitHub repository including name, description, stars, forks, and creation date.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "repos"
                ],
                "summary": "Get repository information",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Repository Owner username (e.g. golang)",
                        "name": "owner",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Repository Name (e.g. go)",
                        "name": "repo",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response with repository details",
                        "schema": {
                            "$ref": "#/definitions/domain.RepoInfo"
                        }
                    },
                    "400": {
                        "description": "Invalid input parameters: owner or repo is empty",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Repository not found on GitHub",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error: failed to fetch data from collector",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.RepoInfo": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "forks_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "stargazers_count": {
                    "type": "integer"
                }
            }
        }
    }
}